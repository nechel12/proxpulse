{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxPulse",
  "version": "0.4.0",
  "identifier": "com.proxpulse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ProxPulse",
        "width": 1220,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 700,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/nechel12/proxpulse/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1OEFDOTk5MDBGNTNERjMKUldUelBmVUFtY21LVmI4YWR2dmE5bE5BQ0FhcE1LaFpxTUhFMUV1cS9QdHdiRGxhb29tYzVyOUMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
