{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: only the links and message dialogs the app uses",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/nechel12/proxpulse"
        },
        {
          "url": "https://github.com/nechel12/proxpulse/*"
        },
        {
          "url": "https://github.com/nechel12/proxpulse-judge"
        },
        {
          "url": "https://members.ip-api.com/*"
        }
      ]
    },
    "dialog:allow-message"
  ]
}
